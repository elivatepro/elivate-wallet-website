{
  "name": "elivate-wallet-website",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/sync-notion-blog.mjs && node --env-file-if-exists=.env scripts/sync-notion-docs.mjs && astro dev",
    "build": "node --env-file-if-exists=.env scripts/sync-notion-blog.mjs && node --env-file-if-exists=.env scripts/sync-notion-docs.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,mdx}\"",
    "preview:worker": "wrangler dev"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.8.10",
    "github-slugger": "^2.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.45.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
