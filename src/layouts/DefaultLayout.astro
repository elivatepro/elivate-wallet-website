---
import BaseHead from "@/components/BaseHead.astro";
import Chatwoot from "@/components/layout/chatwoot.astro";
import Footer from "@/components/layout/footer";
import { IntroLoader } from "@/components/layout/loaders/intro-loader";
import Navbar from "@/components/layout/navbar";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Docs pages bring their own header instead of the marketing navbar. */
  hideNavbar?: boolean;
  /** Docs pages use Ask AI and the contact form instead of the chat widget. */
  hideChat?: boolean;
  /** Docs pages end with their own prev/next and support links. */
  hideFooter?: boolean;
}

const { title, description, image, noindex, hideNavbar, hideChat, hideFooter } =
  Astro.props;

const copyrightYear = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" class="font-text antialiased">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    {isHome && <IntroLoader client:load />}
    {!hideNavbar && <Navbar initialBannerVisible={false} client:load />}
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer copyrightYear={copyrightYear} client:idle />}

    {!hideChat && <Chatwoot />}
  </body>
</html>
