---
import "@/styles/global.css";
import "@/styles/brand.css";
import { Font } from "astro:assets";

import { SITE_METADATA } from "@/consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, noindex = false } = Astro.props;
const finalTitle = title
  ? SITE_METADATA.title.template.replace("%s", title)
  : SITE_METADATA.title.default;
const finalDescription = description || SITE_METADATA.description;
const imageURL = new URL(image || SITE_METADATA.openGraph.image.url, Astro.site);
const isDefaultImage = !image;
const robots = noindex
  ? "noindex, nofollow"
  : `${SITE_METADATA.robots.index ? "index" : "noindex"}, ${SITE_METADATA.robots.follow ? "follow" : "nofollow"}`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", Astro.site).href,
      name: SITE_METADATA.openGraph.siteName,
      url: Astro.site?.href,
      logo: new URL("/icon-512.png", Astro.site).href,
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: SITE_METADATA.openGraph.siteName,
      url: Astro.site?.href,
      description: SITE_METADATA.description,
      publisher: { "@id": new URL("/#organization", Astro.site).href },
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#111314" />
<meta name="color-scheme" content="dark light" />
<meta name="keywords" content={SITE_METADATA.keywords.join(", ")} />
<meta name="author" content={SITE_METADATA.authors[0].name} />
<meta name="creator" content={SITE_METADATA.creator} />
<meta name="publisher" content={SITE_METADATA.publisher} />

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return "dark";
  })();
  if (theme === "dark") {
    document.documentElement.classList.add("dark");
  }
</script>

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />

<title>{finalTitle}</title>
<meta name="title" content={finalTitle} />
<meta name="description" content={finalDescription} />

<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE_METADATA.openGraph.locale} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE_METADATA.openGraph.siteName} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={imageURL} />
{
  isDefaultImage && (
    <>
      <meta property="og:image:width" content={String(SITE_METADATA.openGraph.image.width)} />
      <meta property="og:image:height" content={String(SITE_METADATA.openGraph.image.height)} />
      <meta property="og:image:type" content="image/png" />
    </>
  )
}
<meta property="og:image:alt" content={isDefaultImage ? SITE_METADATA.openGraph.image.alt : finalTitle} />

<meta name="twitter:card" content={SITE_METADATA.twitter.card} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={isDefaultImage ? SITE_METADATA.openGraph.image.alt : finalTitle} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<Font cssVariable="--font-family-sans" preload />
<Font cssVariable="--font-family-display" preload />
<Font cssVariable="--font-family-mono" />